@{
    ViewBag.Title = "Get to Know Joel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <!-- Page Header -->
    <div class="row mb-4 text-center">
        <div class="col">
            <h1 class="display-4">Get to Know Joel</h1>
            <p class="text-muted">
                Learn more about Joel Hilton’s comedic and film background.
            </p>
            <hr />
        </div>
    </div>

    <!-- Links row -->
    <div class="row mb-5">
        <!-- Quick Wits Comedy -->
        <div class="col-md-6 mb-3">
            <h3>Quick Wits Comedy</h3>
            <p class="lead">
                Joel regularly performs improv comedy at 
                <a href="https://www.qwcomedy.com/" target="_blank" class="text-decoration-underline">
                    Quick Wits Comedy
                </a>.
            </p>
            <p>
                If you're in the mood for witty banter, outrageous scenes, 
                and spontaneous laughs, this is the place to be.
            </p>
        </div>

        <!-- Baconsale -->
        <div class="col-md-6 mb-3">
            <h3>Baconsale Podcast</h3>
            <p class="lead">
                Joel co-hosts the weekly 
                <a href="https://baconsale.com/" target="_blank" class="text-decoration-underline">
                    Baconsale
                </a> 
                podcast about films & pop culture.
            </p>
            <p>
                Tune in to hear the latest reviews, debates on classics, 
                and plenty of friendly banter. 
            </p>
        </div>
    </div>

    <!-- Photo link row -->
    <div class="row text-center">
        <div class="col">
            <p>Here’s a photo that links directly to Baconsale:</p>
            <a href="https://baconsale.com/" target="_blank">
                <img src="~/img/Joel2.jpg" 
                     alt="Joel & Baconsale Crew" 
                     class="img-fluid rounded shadow" 
                     style="max-width: 400px;" />
            </a>
        </div>
    </div>
</div>
