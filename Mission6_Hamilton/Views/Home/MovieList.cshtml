@model IEnumerable<Mission6_Hamilton.Models.Movie>

<h2>Movie List</h2>
<table class="table table-striped table-bordered">
    <thead>
    <tr>
        <th>Title</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@(movie.Title ?? "No Title Available")</td>
            <td>@(movie.Director ?? "Unknown Director")</td>
            <td>@(movie.Rating ?? "Not Rated")</td>
            <td>
                <!-- Edit uses AddMovie with the ID -->
                <a asp-action="AddMovie" asp-route-id="@movie.MovieId" class="btn btn-warning">Edit</a>
                <!-- Delete calls JS popup -->
                <button class="btn btn-danger" onclick="confirmDelete(@movie.MovieId)">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="AddMovie" class="btn btn-success">Add New Movie</a>

<script>
    function confirmDelete(movieId) {
        if (confirm("Are you sure you want to delete this movie?")) {
            fetch('/Home/DeleteMovie/' + movieId, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message);
                }
            });
        }
    }
</script>