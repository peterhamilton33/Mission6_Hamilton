@model Mission6_Hamilton.Models.Movie

<h2>@(Model.MovieId == 0 ? "Add Movie" : "Edit Movie")</h2>

<form asp-action="AddMovie" method="post">
    <input type="hidden" asp-for="MovieId" />

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" type="number" min="1888" required />
    </div>

    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Rating"></label>
        <input asp-for="Rating" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Edited"></label>
        <input asp-for="Edited" class="form-control" type="checkbox" />
    </div>

    <div class="form-group">
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CopiedToPlex"></label>
        <input asp-for="CopiedToPlex" class="form-control" type="checkbox" />
    </div>

    <div class="form-group">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
</form>