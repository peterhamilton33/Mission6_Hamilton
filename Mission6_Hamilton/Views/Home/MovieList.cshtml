@model List<Mission6_Hamilton.Models.Movie>

<h2>Movie List</h2>
<table class="table table-bordered">
    <thead>
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>
                <a asp-action="EditMovie" asp-route-id="@movie.MovieId" class="btn btn-warning">Edit</a>
                <button class="btn btn-danger" onclick="confirmDelete(@movie.MovieId)">Delete</button>
            </td>
        </tr>
    }

    </tbody>
</table>

<a asp-action="AddMovie" class="btn btn-success">Add New Movie</a>

<script>
    function confirmDelete(movieId) {
        if (confirm("Are you sure you want to delete this movie?")) {
            fetch('/Home/DeleteMovie', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ id: movieId })
            }).then(response => {
                if (response.ok) {
                    window.location.reload(); // Reload the page after successful delete
                } else {
                    alert("Failed to delete movie.");
                }
            }).catch(error => {
                console.error("Error deleting movie:", error);
            });
        }
    }
</script>

